{
  "name": "@agent-team/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/main.ts",
    "dev:watch": "tsx watch src/main.ts",
    "backfill:usage": "tsx src/scripts/backfill-token-usage.ts",
    "build": "tsup src/main.ts --format esm --dts --out-dir dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@agent-team/protocol": "workspace:*",
    "@agentclientprotocol/sdk": "^0.14.0",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@openai/codex-sdk": "0.142.0",
    "@zed-industries/claude-code-acp": "^0.16.0",
    "better-sqlite3": "^12.0.0",
    "express": "^5.1.0",
    "js-yaml": "^4.1.0",
    "nanoid": "^5.0.0",
    "pino": "^9.0.0",
    "ws": "^8.18.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^5.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.5.13",
    "pino-pretty": "^13.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
