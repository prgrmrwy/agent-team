# agent-team — 环境变量示例
# 复制为 .env（已被 .gitignore 忽略）：cp .env.example .env
# 除 AGENT_TEAM_TOKEN 外全部可选，未设置时用下方默认值。

# --- 本地鉴权 token ---
# 留空即可：server 首次启动会自动生成一个 32 字节随机 token 写回 .env（0600）。
# 也可手动指定一个固定值（前端 dev server 会读同一个值）。
AGENT_TEAM_TOKEN=

# --- 服务端口 / 数据目录 ---
# 后端 HTTP + WS 端口（前端 dev server 固定 5173，代理到此端口）
PORT=3001
# 运行时数据目录（SQLite index.db、每个 task 的 worktree / chatroom / db）
DATA_HOME=~/.agent-team
# development | production | test
NODE_ENV=development
# 日志级别（pino）：trace | debug | info | warn | error
LOG_LEVEL=info
# 单机并行运行的最大 task 数
MAX_CONCURRENT_TASKS=10

# --- Agent 运行时 ---
# codex 可执行文件路径（默认走 PATH 里的 `codex`）。ci/engineer 用 Codex runtime 时需要。
# AGENT_TEAM_CODEX_BIN=codex

# --- CI 工厂 ---
# 1（默认）= 本地 stub 模式，跳过真实 `gh pr create` / 远程 CI 轮询。
# 0 = 真实模式，走完整 pre-merge MR 巡检（需要 gh 鉴权 + 远端仓库）。
AGENT_TEAM_CI_LOCAL=1
